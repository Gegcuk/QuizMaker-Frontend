{
  "name": "quizmaker-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-public-route-artifacts.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:privacy:production": "node --test tests/privacy/analytics-privacy.test.mjs",
    "test:e2e": "node --test tests/e2e/critical-flows.test.mjs",
    "test:nginx": "node tests/deployment/nginx-route-policy.mjs",
    "verify:public-routes": "node scripts/verify-public-route-delivery.mjs",
    "test:deployment-policy": "node tests/deployment/deploy-workflow-policy.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs",
    "audit:production": "npm audit --omit=dev",
    "browserslist:update": "npx update-browserslist-db@latest",
    "preview": "vite preview",
    "generate-sitemap": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api} node scripts/generate-sitemap.mjs",
    "generate-sitemap:static": "PUBLIC_ROUTES_STATIC_ONLY=true npm run generate-sitemap",
    "prerender": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api} node scripts/prerender.mjs",
    "prerender:static": "PUBLIC_ROUTES_STATIC_ONLY=true npm run prerender",
    "verify:prerender": "node scripts/verify-prerendered-seo.mjs",
    "build:prerender:static": "npm run build && npm run generate-sitemap:static && npm run prerender:static && npm run verify:prerender",
    "build:prerender": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api} npm run build && VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api} npm run generate-sitemap && VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api} npm run prerender && REQUIRE_ARTICLE_ROUTES=true npm run verify:prerender"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "^5.101.2",
    "@types/dompurify": "^3.2.0",
    "axios": "^1.10.0",
    "dompurify": "^3.4.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
