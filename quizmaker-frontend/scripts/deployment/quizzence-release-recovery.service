[Unit]
Description=Restore interrupted Quizzence frontend rollout
After=docker.service nginx.service network-online.target
Wants=network-online.target
Requires=docker.service nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 -I /usr/local/lib/quizzence-release/helper.py recover
TimeoutStartSec=3min

[Install]
WantedBy=multi-user.target
